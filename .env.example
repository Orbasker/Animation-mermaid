# Copy to .env.local (git-ignored) for local development. Never commit real values.

# AI Gateway model slug from the current catalog. Optional — defaults to
# anthropic/claude-sonnet-5 when unset. Override to track catalog/config changes.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5

# AI Gateway authentication is OIDC-first and requires NO value here.
# `vercel env pull .env.local --yes` writes a short-lived VERCEL_OIDC_TOKEN
# (~24h) into .env.local. Re-pull when it expires. Do not commit it.
# VERCEL_OIDC_TOKEN=

# Static fallback key for CI or non-Vercel hosts only. Prefer OIDC. Keep the
# real value in Vercel encrypted env settings, never in Git.
# AI_GATEWAY_API_KEY=

# --- design-review story workflow -------------------------------------------

# Where the workflow reaches the eve agent. The agent is mounted into this same
# app, so leave this unset: deployed runs use the deployment's own origin
# (VERCEL_URL) and local runs use http://127.0.0.1:$PORT. Set it only for a split
# or remote agent deployment.
# EVE_AGENT_URL=

# Bearer credential for a protected eve route. Unnecessary for the default
# same-app mount. Keep the real value in Vercel encrypted env settings.
# EVE_AGENT_TOKEN=

# Replaces the agent with a deterministic fixture, for tests and for driving the
# flow locally without a Gateway credential. Refused outright in production.
# DESIGN_REVIEW_STORY_AGENT=fixture

# Scripts the fixture agent (JSON). `failures` fails that many leading attempts
# per phase (analyze | scenes | critique), `failureStatus` picks the status they
# fail with, `unknownEntity` emits a scene naming an entity outside the graph,
# and `sceneCount` fixes how many scenes come back.
# DESIGN_REVIEW_STORY_AGENT_SCRIPT={"failures":{"scenes":2}}
