# Copy to .env.local (git-ignored) for local development. Never commit real values.

# AI Gateway model slug from the current catalog. Optional — defaults to
# anthropic/claude-sonnet-5 when unset. Override to track catalog/config changes.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5

# AI Gateway authentication is OIDC-first and requires NO value here.
# `vercel env pull .env.local --yes` writes a short-lived VERCEL_OIDC_TOKEN
# (~24h) into .env.local. Re-pull when it expires. Do not commit it.
# VERCEL_OIDC_TOKEN=

# Static fallback key for CI or non-Vercel hosts only. Prefer OIDC. Keep the
# real value in Vercel encrypted env settings, never in Git.
# AI_GATEWAY_API_KEY=
