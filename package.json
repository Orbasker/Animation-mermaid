{
  "name": "animation-mermaid",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "license:check": "node tools/check-licenses.mjs",
    "explorer:build": "tsx scripts/generate-explorer.ts",
    "sbom": "node tools/generate-sbom.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "performance:assets": "node tools/check-client-assets.mjs"
  },
  "dependencies": {
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "elkjs": "^0.12.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.30.0"
}
